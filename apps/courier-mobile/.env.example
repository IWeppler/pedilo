# URL de la API (por defecto, el host de Metro con el puerto 4000).
# EXPO_PUBLIC_API_URL=https://api.pedilo.ar

# Supabase Auth: ingreso con código por email (obligatorio).
# EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Largo del código por email: igual a «Email OTP Length» en Supabase (por defecto, 6).
# EXPO_PUBLIC_OTP_LENGTH=6
