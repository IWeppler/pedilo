{
  "expo": {
    "name": "Pedilo Repartidor",
    "slug": "pedilo-courier",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pedilo-courier",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ar.pedilo.courier"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pedilo Repartidor usa tu ubicación durante un envío para que el comercio y el cliente sepan por dónde va el pedido.",
          "locationAlwaysAndWhenInUsePermission": "Pedilo Repartidor usa tu ubicación durante un envío, también con la pantalla apagada, para que el cliente siga su pedido. Deja de compartirla al terminar.",
          "locationAlwaysPermission": "Pedilo Repartidor usa tu ubicación durante un envío, también con la pantalla apagada, para que el cliente siga su pedido. Deja de compartirla al terminar.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b4dbfa1d-5f84-40f4-a9bf-f67062a16368"
      }
    },
    "owner": "ignacioweppler"
  }
}
