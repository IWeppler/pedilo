# Cuenta del cliente con Google o Apple (ADR 0026). Sin estas variables la app funciona igual,
# solo como invitado. Son públicas (clave "publishable" de Supabase), no secretas.
EXPO_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
