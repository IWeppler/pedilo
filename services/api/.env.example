# Copiar a .env y ajustar. Nunca commitear .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres de docker-compose.yml (npm run db:up)
DATABASE_URL=postgres://pedilo:pedilo@localhost:5433/pedilo

# Sin SUPABASE_URL la API acepta tokens firmados con claves locales (npm run dev:token).
# En producción SUPABASE_URL es obligatoria (ADR 0004).
# SUPABASE_URL=https://<project-ref>.supabase.co

# Orígenes web permitidos (panel comercio y admin), separados por coma.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081,http://localhost:8082

# Firma de los tokens de seguimiento de pedidos (obligatorio en producción, mínimo 16 caracteres).
# ORDER_TOKEN_SECRET=

# Minutos que tiene el comercio para aceptar un pedido antes de que venza solo (ADR 0008).
# ORDER_ACCEPT_TIMEOUT_MINUTES=15
# Cada cuántos segundos se buscan pedidos vencidos. 0 apaga el worker dentro de la API.
# ORDER_EXPIRY_SWEEP_SECONDS=30

# Web Push para avisar al comercio con la pestaña cerrada (ADR 0009). Generar con `npm run push:keys`.
# Sin las claves, los avisos push se omiten (el resto funciona igual).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contacto para los servicios de push (obligatorio en producción): mailto:... o https://...
# VAPID_SUBJECT=mailto:soporte@tu-dominio
# Cada cuántos segundos se envían los avisos pendientes. 0 apaga el worker.
# PUSH_OUTBOX_SWEEP_SECONDS=5

# Anti-abuso de pedidos anónimos (ADR 0010). 0 desactiva cada límite.
# ORDER_RATE_LIMIT_PER_IP=6
# ORDER_MAX_ACTIVE_PER_PHONE=3
# ORDER_MAX_DAILY_PER_PHONE=12
# Detrás de un proxy/balanceador: cuántos saltos confiar para leer la IP real.
# TRUST_PROXY_HOPS=0

# Liquidación semanal de comisiones (ADR 0013): corte los lunes 00:00 en esta zona.
SETTLEMENT_TIMEZONE=America/Argentina/Buenos_Aires
# Días desde el corte hasta el vencimiento.
SETTLEMENT_DUE_DAYS=7
# Cada cuántos minutos se intenta cerrar la semana (idempotente). 0 lo apaga.
SETTLEMENT_SWEEP_MINUTES=60
