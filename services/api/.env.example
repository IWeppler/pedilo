# Copiar a .env y ajustar. Nunca commitear .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres de docker-compose.yml (npm run db:up)
DATABASE_URL=postgres://pedilo:pedilo@localhost:5433/pedilo

# Sin SUPABASE_URL la API acepta tokens firmados con claves locales (npm run dev:token).
# En producción SUPABASE_URL es obligatoria (ADR 0004).
# SUPABASE_URL=https://<project-ref>.supabase.co

# Orígenes web permitidos (panel comercio y admin), separados por coma.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081,http://localhost:8082

# Firma de los tokens de seguimiento de pedidos (obligatorio en producción, mínimo 16 caracteres).
# ORDER_TOKEN_SECRET=
