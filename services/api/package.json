{
  "name": "@pedilo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "dev:token": "tsx --env-file-if-exists=.env src/scripts/dev-token.ts",
    "openapi": "tsx src/scripts/openapi.ts",
    "push:keys": "tsx src/scripts/push-keys.ts",
    "admin:grant": "tsx --env-file-if-exists=.env src/scripts/grant-admin.ts",
    "db:seed:demo": "tsx --env-file-if-exists=.env src/db/seed-demo.ts",
    "db:reset": "tsx --env-file-if-exists=.env src/db/reset.ts && npm run db:seed && npm run db:seed:demo"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@types/node": "^22.20.5",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.5",
    "@pedilo/domain": "*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.18",
    "postgres": "^4.1.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  }
}
