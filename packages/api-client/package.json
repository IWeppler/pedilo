{
  "name": "@pedilo/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Cliente tipado de la API de Pedilo, generado desde services/api/openapi.json.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "generate": "openapi-typescript ../../services/api/openapi.json -o src/schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  }
}
